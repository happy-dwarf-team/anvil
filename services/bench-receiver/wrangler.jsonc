// The start-up benchmark receiver (docs/spec/benchmark-v1.md, section 9).
// Deployed by hand: see README.md. CI tests it and holds no Cloudflare secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anvil-bench-receiver",
  "main": "src/index.js",
  // Compiles the schemas in schemas/ before every deploy.
  "build": { "command": "node scripts/compile-schemas.js" },
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "bench.happydwarf.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anvil-bench",
      // Created in the EU jurisdiction (README.md, "First deployment").
      "database_id": "030cca9d-34de-41a2-af66-bee76f898d5d",
      "migrations_dir": "migrations"
    }
  ],
  // Check 2: 5 requests per 60 s per IP.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // Starting values of the checks; change them here and redeploy.
  "vars": {
    "MAX_BODY_BYTES": 262144,
    "DAILY_LIMIT": 2000,
    "MIN_START_MS": 1000,
    "MAX_START_MS": 600000,
    "RETENTION_MONTHS": 24
  },
  // Retention, daily at 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] },
  // The Worker logs one line per request itself; invocation logs would add the
  // request's metadata.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
